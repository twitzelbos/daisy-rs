From 44c38faf8af0d95f7bc1e5f5b2c64e391329f3dd Mon Sep 17 00:00:00 2001
From: Thomas Witzel <witzel.thomas@gmail.com>
Date: Tue, 4 Aug 2026 17:42:25 -0700
Subject: [PATCH 1/2] sysbus: region-aware multibyte block access for
 ConnectionRegion peripherals
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A peripheral registered over multiple ConnectionRegions (BusMultiRegistration)
exposes a single IMultibyteWritePeripheral.{ReadBytes,WriteBytes}. When the
system bus routes a block access (LoadELF/LoadBinary, SystemBus.ReadBytes/
WriteBytes) it passes an offset relative to the matched registration, so the
peripheral cannot tell which region was hit — both registrations are
offset-relative and start near 0. This makes it impossible for e.g. an XIP
flash controller to serve block loads of its memory-mapped window through its
SPI protocol while keeping ordinary register semantics on its control region.

Add an optional IPerConnectionRegionMultibyteAccess interface whose ReadBytes/
WriteBytes additionally take the ConnectionRegion name. SystemBus.ReadBytes and
WriteBytes prefer it, when implemented, for accesses arriving through a
BusMultiRegistration; all other accesses are unaffected. This is a pure
addition — the scalar access machinery (BusAccess/PeripheralAccessMethods) and
existing IMultibyteWritePeripheral dispatch are untouched.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 .../Bus/IMultibyteWritePeripheral.cs          | 19 ++++++++++++++
 .../Main/Peripherals/Bus/SystemBus.cs         | 26 +++++++++++++++++++
 2 files changed, 45 insertions(+)

diff --git a/src/Emulator/Main/Peripherals/Bus/IMultibyteWritePeripheral.cs b/src/Emulator/Main/Peripherals/Bus/IMultibyteWritePeripheral.cs
index 2548a6b..5f1392f 100644
--- a/src/Emulator/Main/Peripherals/Bus/IMultibyteWritePeripheral.cs
+++ b/src/Emulator/Main/Peripherals/Bus/IMultibyteWritePeripheral.cs
@@ -18,6 +18,25 @@ public interface IMultibyteWritePeripheral
         void WriteBytes(long offset, byte[] array, int startingIndex, int count, IPeripheral context = null);
     }
 
+    // Region-aware multibyte block access.
+    //
+    // A peripheral registered over several ConnectionRegions (via BusMultiRegistration)
+    // exposes only a single IMultibyteWritePeripheral.{ReadBytes,WriteBytes}, so block
+    // accesses routed by the system bus (LoadELF/LoadBinary, SystemBus.ReadBytes/WriteBytes)
+    // cannot tell which region was hit — the offset alone is ambiguous because each
+    // registration is offset-relative and both start near 0. A peripheral that implements
+    // this interface additionally receives the ConnectionRegion name, so e.g. an XIP flash
+    // controller can drive its SPI protocol for the "xip" window while keeping ordinary
+    // register semantics on its control region. When present, the system bus prefers these
+    // methods over IMultibyteWritePeripheral for accesses that arrive through a
+    // BusMultiRegistration.
+    public interface IPerConnectionRegionMultibyteAccess
+    {
+        byte[] ReadBytes(string connectionRegion, long offset, int count, IPeripheral context = null);
+
+        void WriteBytes(string connectionRegion, long offset, byte[] array, int startingIndex, int count, IPeripheral context = null);
+    }
+
     public static class IMultibyteWritePeripheralExtensions
     {
         public static void FillWithRepeatingData(this IMultibyteWritePeripheral peripheral, byte[] data, long? size = null)
diff --git a/src/Emulator/Main/Peripherals/Bus/SystemBus.cs b/src/Emulator/Main/Peripherals/Bus/SystemBus.cs
index 541f71e..0b06017 100644
--- a/src/Emulator/Main/Peripherals/Bus/SystemBus.cs
+++ b/src/Emulator/Main/Peripherals/Bus/SystemBus.cs
@@ -931,6 +931,19 @@ public void WriteBytes(byte[] bytes, ulong address, int startingIndex, long coun
                 }
                 foreach(var target in targets)
                 {
+                    // daisy-rs XIP-fidelity patch: when the access arrives through a
+                    // ConnectionRegion (BusMultiRegistration) and the peripheral is region-aware,
+                    // route the block write to the region-specific method so it knows which region
+                    // was hit (e.g. QSPI "xip" window vs the controller's register region).
+                    if(target.What.RegistrationPoint is BusMultiRegistration multiRegionWrite
+                        && target.What.Peripheral is IPerConnectionRegionMultibyteAccess regionPeripheralWrite)
+                    {
+                        checked
+                        {
+                            regionPeripheralWrite.WriteBytes(multiRegionWrite.ConnectionRegionName, (long)(target.Offset - target.What.RegistrationPoint.Range.StartAddress + target.What.RegistrationPoint.Offset), bytes, startingIndex + (int)target.SourceIndex, (int)target.SourceLength);
+                        }
+                        continue;
+                    }
                     var multibytePeripheral = target.What.Peripheral as IMultibyteWritePeripheral;
                     if(multibytePeripheral != null)
                     {
@@ -992,6 +1005,19 @@ public void ReadBytes(ulong address, int count, byte[] destination, int startInd
                 }
                 foreach(var target in targets)
                 {
+                    // daisy-rs XIP-fidelity patch: mirror of the region-aware write path — block
+                    // reads through a ConnectionRegion go to the region-specific method so an XIP
+                    // controller can serve them via its SPI protocol instead of a generic access.
+                    if(target.What.RegistrationPoint is BusMultiRegistration multiRegionRead
+                        && target.What.Peripheral is IPerConnectionRegionMultibyteAccess regionPeripheralRead)
+                    {
+                        checked
+                        {
+                            var chunk = regionPeripheralRead.ReadBytes(multiRegionRead.ConnectionRegionName, (long)(target.Offset - target.What.RegistrationPoint.Range.StartAddress + target.What.RegistrationPoint.Offset), (int)target.SourceLength, context);
+                            Array.Copy(chunk, 0, destination, startIndex + (int)target.SourceIndex, (int)target.SourceLength);
+                        }
+                        continue;
+                    }
                     var memory = target.What.Peripheral as MappedMemory;
                     if(memory != null)
                     {
