+using Antmicro.Renode.Peripherals.Bus;
+
+namespace Antmicro.Renode.Peripherals
+{
+    // Marker for a bus peripheral whose registered range(s) should be flagged
+    // executable-IO (IO_MEM_EXECUTABLE_IO) so the CPU may fetch instructions from
+    // them through the ordinary bus read path (tlib_read_* -> SystemBus.ReadByte)
+    // instead of requiring a host-RAM-backed MappedMemory. ArrayMemory implements
+    // this; so can e.g. an XIP flash controller that serves code via its own
+    // (protocol-driven) read methods.
+    public interface IExecutableInPlaceMemory : IBusPeripheral
+    {
+    }
+}
diff --git a/src/Emulator/Main/Peripherals/Memory/ArrayMemory.cs b/src/Emulator/Main/Peripherals/Memory/ArrayMemory.cs
index 6df9e2a..9e68d9e 100644
--- a/src/Emulator/Main/Peripherals/Memory/ArrayMemory.cs
+++ b/src/Emulator/Main/Peripherals/Memory/ArrayMemory.cs
@@ -16,7 +16,7 @@
 
 namespace Antmicro.Renode.Peripherals.Memory
 {
-    public class ArrayMemory : IMemory, ICanLoadFiles, IEndiannessAware
+    public class ArrayMemory : IMemory, IExecutableInPlaceMemory, ICanLoadFiles, IEndiannessAware
     {
         public ArrayMemory(byte[] source)
