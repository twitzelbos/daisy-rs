:name: daisy-boot
:description: Boot the daisy-rs bootloader in Renode and observe the LED behaviour.
:origin: daisy-rs/renode

# Renode scenario file. Runs `daisy-boot` in a simulated Daisy Seed and
# leaves the machine paused at the end so tests / interactive sessions can
# inspect state. Robot Framework tests source this via `Execute Command`.

$name?="daisy-boot"

mach create $name
# $ORIGIN is the directory containing this .resc file. Using it makes the
# scenario runnable from any CWD (Renode's default and renode-test's
# differ), including from `renode-test renode/...` at the repo root.
machine LoadPlatformDescription $ORIGIN/daisy_seed.repl

# Point at the release build, resolved from repo root two levels up.
$bin?=$ORIGIN/../target/thumbv7em-none-eabihf/release/daisy-boot

# Robot tests use `Create LED Tester sysbus.gpioPortC.userLed` and then
# `Assert LED Is Blinking` for state tracking — no monitor-level hook
# needed. (Renode 1.16's `Miscellaneous.LED` peripheral doesn't expose
# `AddStateChangedHook`; the LED tester Robot keyword tracks changes.)

macro reset
"""
    sysbus LoadELF $bin
"""

runMacro $reset

# Do NOT start emulation here — Robot tests decide when to `Start Emulation`
# so they can install pin watches or hooks before the CPU runs. Interactive
# users can just `start` from the Renode monitor.
